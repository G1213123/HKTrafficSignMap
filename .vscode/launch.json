{
  "version": "0.2.0",
  "configurations": [
{
      "name": "Next.js: debug with Chrome",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://.+)|ready - started server on .*",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Next.js: Chrome (manual)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "skipFiles": ["${workspaceFolder}/node_modules/**", "<node_internals>/**"]
    },
    {
      "name": "Generate Signed URL (Google Cloud Storage)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/app/lib/generateSignedUrlGoogle.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env.local",
      "args": [
        "public/data/svgs/TS_101.svg"
      ]
    }
  ]
}