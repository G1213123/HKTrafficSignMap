{
  "name": "hk-traffic-sign-map-web",
  "version": "1.4.3",
  "private": true,
  "scripts": {
    "update-version": "node scripts/update-version.js",
    "sync-wfs": "python3 jobs/sync_wfs_layers.py",
    "build-mvt": "node --max-old-space-size=7168 jobs/build_vector_tiles.js",
    "dev": "npm run update-version && next dev",
    "build": "npm run update-version && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test app/components/*.test.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.17.2",
    "@mapbox/geojson-normalize": "^0.0.1",
    "@mapbox/vector-tile": "^2.0.4",
    "@turf/turf": "^7.3.5",
    "dotenv": "^17.2.1",
    "geojson-vt": "^4.0.3",
    "lucide-react": "latest",
    "maplibre-gl": "^5.23.0",
    "next": "^16.1.6",
    "pbf": "^4.0.1",
    "proj4": "^2.20.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vt-pbf": "^3.1.3"
  },
  "optionalDependencies": {
    "stream-json": "^1.7.5"
  }
}
